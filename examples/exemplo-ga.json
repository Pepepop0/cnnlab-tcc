{
  "kind": "ga",
  "dataset": {
    "name": "cifar100",
    "root": "./data",
    "val_fraction": 0.1,
    "class_subset": null,
    "cache_on_device": true,
    "augment_flip": true
  },
  "ga": {
    "population_size": 8,
    "generations": 6,
    "epochs_per_individual": 3,
    "crossover_prob": 0.6,
    "mutation_prob": 0.3,
    "mutation_sigma": 0.15,
    "tournament_size": 3,
    "elitism": 1,
    "seed": 42,
    "search_space": {
      "lr_log10": [-4.0, -2.0],
      "weight_decay_log10": [-6.0, -3.0],
      "dropout": [0.0, 0.5],
      "batch_size": [64, 128, 256],
      "optimizer": ["adam", "sgd_momentum"],
      "base_filters": [16, 32, 64],
      "n_blocks": [2, 3]
    }
  },
  "amp": true,
  "channels_last": true,
  "note": "sessao de demonstracao"
}
